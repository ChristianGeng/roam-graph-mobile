;;; char_width.el --- Write lib/graph/char_width.dart from Emacs's char-width  -*- lexical-binding: t; -*-

;; org-roam cuts graph titles with `truncate-string-to-width', which counts
;; columns as Emacs's `char-width' does: 2 for CJK characters and most
;; emoji, 0 for combining marks. The app uses the same widths. Run:
;;
;;   emacs --batch -l tool/char_width.el > lib/graph/char_width.dart

(let ((c 0) (start nil) (width nil) (ranges nil))
  ;; Every code point up to U+3FFFF; the surrogates are no characters.
  (while (<= c #x3FFFF)
    (let ((w (if (and (>= c #xD800) (<= c #xDFFF)) 1 (char-width c))))
      (unless (and start (eq w width))
        (when (and start (/= width 1)) (push (list start (1- c) width) ranges))
        (setq start c width w)))
    (setq c (1+ c)))
  (when (/= width 1) (push (list start #x3FFFF width) ranges))
  (princ (format "// Generated by tool/char_width.el from %s. Do not edit.\n\n"
                 (concat "Emacs " emacs-version)))
  (princ "/// Ranges of code points whose width is not 1 column, as Emacs's
/// `char-width` gives it: first, last, width.
const charWidthRanges = <int>[\n")
  (dolist (r (reverse ranges))
    (princ (format "  0x%X, 0x%X, %d,\n" (nth 0 r) (nth 1 r) (nth 2 r))))
  (princ "];
"))
